# Public URL used by Caddy. Use https://your-domain.example after DNS is configured.
# For a temporary IP-only test, use http://203.0.113.10.
APP_PUBLIC_URL=https://app.example.com

# Generate with: openssl rand -hex 32
APP_KEY=replace-with-64-random-hex-characters
TZ=Asia/Vladivostok

DB_DATABASE=nocobase
DB_USER=nocobase
DB_PASSWORD=replace-with-a-random-database-password

MINIO_ROOT_USER=logcompany
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-password
PROCESS_DOCUMENTS_MINIO_BUCKET=log-company-process-documents
CHAT_MINIO_BUCKET=log-company-chats

# Credentials for dynamic authentication in the Rosaccreditation public registry.
FSA_USERNAME=replace-with-fsa-username
FSA_PASSWORD=replace-with-fsa-password
FSA_BASE_URL=https://pub.fsa.gov.ru
EAEU_BASE_URL=https://nsi.eaeunion.org
SWIS_BASE_URL=https://swis.trade.kg

# These values are used only when NocoBase initializes an empty database.
INIT_LANG=ru-RU
INIT_ROOT_EMAIL=admin@example.com
INIT_ROOT_USERNAME=admin
INIT_ROOT_NICKNAME=Administrator
INIT_ROOT_PASSWORD=Replace-With-A-Strong-Password1!
