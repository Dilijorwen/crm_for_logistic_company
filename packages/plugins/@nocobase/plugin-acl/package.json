    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "@nocobase/acl": "2.x",
    "@nocobase/actions": "2.x",
    "@nocobase/cache": "2.x",
    "@nocobase/client": "2.x",
    "@nocobase/database": "2.x",
    "@nocobase/server": "2.x",
    "@nocobase/test": "2.x",
    "@nocobase/utils": "2.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocobase/nocobase.git",
    "directory": "packages/plugins/acl"
  }
