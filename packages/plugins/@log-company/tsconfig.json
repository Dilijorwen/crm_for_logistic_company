{
  "compilerOptions": {
    "allowJs": false,
    "baseUrl": "../../..",
    "paths": {
      "@nocobase/plugin-file-manager/server": ["packages/plugins/@nocobase/plugin-file-manager/src/server"],
      "@nocobase/plugin-file-manager/client": ["packages/plugins/@nocobase/plugin-file-manager/src/client"]
    },
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "jsx": "react",
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2021"
  },
  "include": ["*/src/**/*.ts", "*/src/**/*.tsx", "__tests__/**/*.ts", "vitest.config.ts"],
  "exclude": ["*/dist", "*/node_modules"]
}
