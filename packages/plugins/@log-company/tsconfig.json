{
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "jsx": "react",
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2021"
  },
  "include": ["*/src/**/*.ts", "*/src/**/*.tsx", "__tests__/**/*.ts", "vitest.config.ts"],
  "exclude": ["*/dist", "*/node_modules"]
}
